TOKEN_KEY=PixieHollow_token_key
LOCALHOST_INSTANCE=true
SESSION_SECRET=PixieHollow_secret
API_TOKEN=PixieHollow_api

# OTP message director, so routes that write Mongo directly can keep the
# cluster's cached `db` fields in sync. Must match `messagedirector.bind` in
# game-server/config/otp.yml.
MD_HOST=127.0.0.1
MD_PORT=6666
